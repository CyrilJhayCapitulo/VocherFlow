rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection: strictly protected
    match /admins/{adminId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == adminId);
    }

    // Vouchers collection
    match /vouchers/{voucherId} {
      // Allow public verification/validation reads; writes restricted or handled via secure backend transactions
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs collection: append-only / read by admins
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
